rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas para la colección de pedidos
    match /orders/{orderId} {
      // Cualquier usuario puede crear un pedido (desde el checkout)
      allow create: if true;
      
      // Solo usuarios autenticados pueden leer o listar pedidos (Panel Admin)
      // Dado que usamos signInAnonymously en el admin, request.auth != null será true.
      allow read, list: if request.auth != null;
      
      // No permitimos borrar o editar pedidos por ahora por seguridad
      allow update, delete: if false;
    }
    
    // Reglas para el inventario (si lo hubiera en Firestore)
    match /inventory/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Regla general de denegación para el resto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
